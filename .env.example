# Voice Gender App — Telegram Configuration
# Copy this file to .env and fill in your credentials
# The .env file is in .gitignore and will NOT be pushed to GitHub

# ── Storage Settings ─────────────────────────────────────────────────────────
# STORAGE_BASE=/data/voiceguard
# RECORDINGS_DIR=/data/voiceguard/recordings
# TEMP_UPLOADS_DIR=/data/voiceguard/uploads
# LOGS_DIR=/data/voiceguard/logs

# ── Telegram Bot Settings ────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram:
#   1. Open Telegram -> search @BotFather
#   2. Send /newbot -> choose a name -> copy the token below
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Get your Chat ID from @userinfobot on Telegram:
#   1. Search @userinfobot -> send /start -> copy the ID number
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ── Notification Settings ────────────────────────────────────────────────────
# 'all'    = notify for every upload (male and female)
# 'female' = only notify when female voice is detected

# ── Email SMTP Settings ──────────────────────────────────────────────────────
# Set up a Gmail App Password if using Gmail:
#   1. Go to Google Account -> Security -> 2-Step Verification
#   2. Go to App Passwords at the bottom -> Create one for "Mail"
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD
EMAIL_TO=RECEIVER_EMAIL@example.com
NOTIFY_ON=all



# ── Storage ──────────────────────────────────────────────────────────────────
# Folder where uploaded audio files are saved (relative to main.py)
RECORDINGS_DIR=recordings

# ── API Security ─────────────────────────────────────────────────────────────
# Required in the "X-API-Key" header to call /predict-url, /recordings and /api/admin/* routes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# ── Concurrency ──────────────────────────────────────────────────────────────
# Max audio jobs processed at once (Whisper + ensemble models per job). Raise
# this only if your server has enough RAM/CPU to back it — default is safe for
# a small VPS.
MAX_CONCURRENT_JOBS=2

# ── Public URL ───────────────────────────────────────────────────────────────
# Used to build the admin dashboard link in manual_review email alerts.
# Set this to your real domain in production (e.g. https://voiceguard.yourapp.com)
PUBLIC_BASE_URL=http://127.0.0.1:8000
